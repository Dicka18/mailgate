{
  "name": "mailgate-sdk",
  "version": "1.1.1",
  "mcpName": "io.github.Dicka18/mailgate",
  "description": "Zero-dependency client SDK, CLI, Playwright fixture, and stdio MCP server for MailGate self-hosted OTP & magic-link inboxes.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Dicka18/mailgate/tree/main/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dicka18/mailgate.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/Dicka18/mailgate/issues"
  },
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "bin": {
    "mailgate": "./cli.mjs",
    "mailgate-mcp": "./mcp.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./playwright": {
      "types": "./playwright.d.ts",
      "import": "./playwright.mjs"
    },
    "./cypress": {
      "types": "./cypress.d.ts",
      "import": "./cypress.mjs"
    },
    "./mcp": {
      "import": "./mcp.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "playwright.mjs",
    "playwright.d.ts",
    "cypress.mjs",
    "cypress.d.ts",
    "cli.mjs",
    "mcp.mjs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mailgate",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "otp",
    "e2e",
    "playwright",
    "cypress",
    "email-testing",
    "magic-link"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
